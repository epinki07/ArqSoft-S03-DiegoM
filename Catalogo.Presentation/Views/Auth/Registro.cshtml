@{
    ViewData["Title"] = "Registrarse";
}

<link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />

<div class="form-container">
    <h1>Crear cuenta</h1>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger alert-custom" role="alert">
            @foreach (var modelState in ViewData.ModelState.Values)
            {
                @foreach (var error in modelState.Errors)
                {
                    <p>@error.ErrorMessage</p>
                }
            }
        </div>
    }

    <form asp-action="Registro" method="post">
        <div class="form-group">
            <label for="usuario">Nombre de usuario</label>
            <input type="text" id="usuario" name="usuario" placeholder="Ej: musicalover2024" required />
            <small>Entre 3 y 50 caracteres, solo letras, números, guiones y guiones bajos.</small>
        </div>

        <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" placeholder="Ej: correo@ejemplo.com" required />
        </div>

        <div class="form-group">
            <label for="password">Contraseña</label>
            <input type="password" id="password" name="password" placeholder="Mínimo 6 caracteres" required />
            <small>Mínimo 6 caracteres para tu seguridad.</small>
        </div>

        <div class="form-group">
            <label for="passwordConfirm">Confirmar contraseña</label>
            <input type="password" id="passwordConfirm" name="passwordConfirm" placeholder="Repite tu contraseña" required />
        </div>

        <div class="form-group">
            <button type="submit" class="btn-primary-custom">
                Registrarse
            </button>
        </div>
    </form>

    <div class="form-footer">
        <p>Ya tienes cuenta? <a asp-action="Login">Inicia sesión aquí</a></p>
        <p><a asp-controller="Home" asp-action="Index">Volver al inicio</a></p>
    </div>
</div>
