@using Microsoft.AspNetCore.Http
@model CatalogoApp.Domain.Models.Item

<div class="detail-container">
    <div class="detail-header">
        <p class="detail-kicker">Ficha del álbum</p>
        <h1 class="detail-title">@Model.Nombre</h1>
    </div>

    <div class="detail-grid">
        <div class="detail-item">
            <div class="detail-label">Artista</div>
            <div class="detail-value">@Model.Artista</div>
        </div>

        <div class="detail-item">
            <div class="detail-label">Género</div>
            <div class="detail-value">@Model.Genero</div>
        </div>

        <div class="detail-item">
            <div class="detail-label">Formato</div>
            <div class="detail-value">@Model.Formato</div>
        </div>

        <div class="detail-item">
            <div class="detail-label">Año</div>
            <div class="detail-value">@Model.Ano</div>
        </div>
    </div>

    <section class="rating-section">
        <div>
            <h2>Calificación</h2>
            <p>Promedio basado en los comentarios registrados.</p>
        </div>
        <div class="rating-display">
            @{
                double promedio = ViewBag.PromedioRating ?? 0;
                int cantidadComentarios = ViewBag.CantidadComentarios ?? 0;
            }
            <div class="rating-stars" aria-label="Calificación promedio">
                @for (int i = 1; i <= 5; i++)
                {
                    if (i <= Math.Round(promedio))
                    {
                        <span class="star filled">★</span>
                    }
                    else
                    {
                        <span class="star">☆</span>
                    }
                }
            </div>
            <div class="rating-meta">
                <strong>@Math.Round(promedio, 1) / 5</strong>
                <span>@cantidadComentarios comentario(s)</span>
            </div>
        </div>
    </section>

    <section class="comments-section">
        <div class="section-heading">
            <h2>Comentarios</h2>
            <span>@Model.Comentarios.Count total</span>
        </div>

        @if (Model.Comentarios.Any())
        {
            <div class="comments-list">
                @foreach (var comentario in Model.Comentarios.OrderByDescending(c => c.Fecha))
                {
                    <article class="comment-item">
                        <div class="comment-header">
                            <strong>@comentario.NombreUsuario</strong>
                            <span>@comentario.Fecha.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                        <div class="comment-rating">
                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= comentario.Rating)
                                {
                                    <span class="star-small filled">★</span>
                                }
                                else
                                {
                                    <span class="star-small">☆</span>
                                }
                            }
                            <span class="rating-badge">@comentario.Rating/5</span>
                        </div>
                        <p class="comment-text">@comentario.Texto</p>
                    </article>
                }
            </div>
        }
        else
        {
            <p class="no-comments">No hay comentarios todavía.</p>
        }
    </section>

    @{
        var usuarioLogueado = Context.Session.GetString("usuarioNombre");
    }

    <section class="add-comment-section">
        <h2>Añadir comentario</h2>

        @if (!string.IsNullOrEmpty(usuarioLogueado))
        {
            @if (TempData["Exito"] != null)
            {
                <div class="alert alert-success alert-custom">
                    <p>@TempData["Exito"]</p>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-custom">
                    <p>@TempData["Error"]</p>
                </div>
            }

            <form asp-action="AgregarComentario" method="post" class="comment-form">
                <input type="hidden" name="itemId" value="@Model.Id" />

                <div class="form-group">
                    <label for="ratingInput">Calificación</label>
                    <div class="rating-input">
                        <div class="stars-selector" id="starsSelector">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <button class="star-label" type="button" data-value="@i" title="@i estrella(s)">★</button>
                            }
                            <input type="hidden" id="ratingInput" name="rating" value="0" />
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label for="texto">Tu comentario</label>
                    <textarea id="texto" name="texto" placeholder="Escribe tu comentario" minlength="5" maxlength="500" required rows="4"></textarea>
                    <small>Entre 5 y 500 caracteres.</small>
                </div>

                <div class="form-group">
                    <button type="submit" class="btn-submit">Enviar comentario</button>
                </div>
            </form>
        }
        else
        {
            <div class="alert alert-info alert-custom">
                <p>Debes <a asp-controller="Auth" asp-action="Login">iniciar sesión</a> para comentar.</p>
            </div>
        }
    </section>

    <div class="detail-actions">
        <a asp-action="Index" class="btn-back">Volver a la colección</a>
    </div>
</div>

